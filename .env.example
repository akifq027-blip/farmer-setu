# Server Port
PORT=3000

# ==============================================================================
# Aiven MySQL Database Configuration
# ==============================================================================

# Option 1: Aiven MySQL Full Service URI (Recommended)
# Copy the 'Service URI' from your Aiven Console (Overview tab):
# Format: mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx-project.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED
AIVEN_MYSQL_URL=
MYSQL_URL=

# Option 2: Individual Connection Parameters (Alternative)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true

# Optional: Path to custom CA Certificate (if needed)
# MYSQL_CA_PATH=./ca.pem

# ==============================================================================
# Vapi Voice Assistant (Kisan Mitr)
# ==============================================================================
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
